# FlowForge AI Backend Configuration
# Copy this file to ".env" (same folder) and put your real Gemini API key below.
# NEVER commit .env or share your key. If a key was ever posted publicly or sent
# to someone, delete it at https://aistudio.google.com/apikey and create a new one.

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model. Pinned to a stable model name (not a rolling "-latest" alias).
GEMINI_MODEL=gemini-3.6-flash

# Fallback models, tried in order if the primary is overloaded/unavailable.
# Leave the line out to use the defaults below, or set it empty to disable fallbacks.
# Check the names against YOUR key with:  python -m scripts.list_gemini_models
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Timeout for ONE attempt, in milliseconds. Google enforces this as a server-side
# deadline, so too small a value causes "504 DEADLINE_EXCEEDED" on big blueprints.
GEMINI_TIMEOUT_MS=75000

# Overall time budget for ONE user request across all retries and fallbacks (ms).
# Keep it below the frontend timeout (180000).
GEMINI_TOTAL_TIMEOUT_MS=150000

# Maximum attempts PER MODEL, including the first (2 = try once, retry once).
GEMINI_MAX_RETRIES=2

# Backoff before a retry, in ms (doubles each retry, capped at 5 s).
GEMINI_BACKOFF_BASE_MS=500

# Thinking effort: low (fast, recommended) | medium | high | default (model default).
GEMINI_THINKING_LEVEL=low

# Maximum response size in tokens (thinking tokens count toward this).
GEMINI_MAX_OUTPUT_TOKENS=32768

# Allowed CORS origins (comma-separated). Must include the exact address you open
# the frontend at (localhost and 127.0.0.1 count as different origins).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# AI provider implementation
AI_PROVIDER=gemini

# Application environment (development | production)
ENVIRONMENT=development
